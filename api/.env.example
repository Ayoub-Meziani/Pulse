# PULSE API configuration: variable names with safe placeholders only. Never commit real values.
# The API reads real environment variables (it does not load this file itself). Copy it to the
# git-ignored api/.env and export it before starting the server, for example in Git Bash:
#   set -a; source .env; set +a; uvicorn app.main:create_app --factory --reload

PULSE_ENV=dev

# Postgres connection used by the API (a privileged server-side connection; permissions are
# enforced in the API). Local test database started by `python scripts/test_db.py up`.
PULSE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Supabase project URL and the PUBLISHABLE (anon) key, used only by the login proxy.
# Never put a service-role key here: the API does not use one.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Demo mode swaps the emergency number for a teammate's phone and shows a DEMO banner.
PULSE_DEMO_MODE=true
PULSE_DEMO_NUMBER=+213 000 00 00 00

# Optional overrides
# PULSE_EMERGENCY_NUMBERS=[{"id":"...","label_fr":"...","label_ar":"...","number":"...","verified":false,"source":"..."}]
# PULSE_PRIMARY_NUMBER_ID=dz-14
# PULSE_ML_MODEL_VERSION=mbp-v1
